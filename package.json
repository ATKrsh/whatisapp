{
  "name": "whatisapp",
  "version": "1.0.0",
  "description": "AI-powered auto-replier for WhatsApp with a web dashboard",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "gemini",
    "ai",
    "replier"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "puppeteer": "^25.1.0",
    "qrcode-terminal": "^0.12.0",
    "sqlite3": "^5.1.7",
    "whatsapp-web.js": "^1.25.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^31.3.1",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.whatisapp.app",
    "productName": "WhatIsApp",
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "asarUnpack": [
      "node_modules/puppeteer/**",
      "node_modules/@puppeteer/**"
    ]
  }
}
